{
  "name": "democracy-monitor",
  "version": "1.0.0",
  "description": "Live dashboard tracking signals of executive-power centralization across US government institutions",
  "license": "MIT",
  "author": "Michael Kelly",
  "repository": {
    "type": "git",
    "url": "https://github.com/agile-explorations/democracy-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/agile-explorations/democracy-monitor/issues"
  },
  "homepage": "https://github.com/agile-explorations/democracy-monitor#readme",
  "keywords": [
    "democracy",
    "executive-power",
    "oversight",
    "transparency",
    "government",
    "dashboard"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:patterns": "opengrep scan --error --config .opengrep/ .",
    "lint:unused": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:init": "tsx lib/db/init.ts",
    "db:migrate": "tsx lib/db/migrate.ts",
    "snapshot": "tsx lib/cron/snapshot.ts",
    "backfill": "tsx lib/cron/backfill.ts",
    "demo:seed": "tsx lib/cron/seed-demo-data.ts",
    "scores:recompute": "tsx lib/cron/recompute-scores.ts",
    "backtest": "tsx lib/cron/run-backtest.ts",
    "retrospective": "tsx lib/cron/run-retrospective.ts",
    "baselines:compute": "tsx lib/cron/compute-baseline-stats.ts",
    "seed:review": "tsx lib/seed/review-report.ts",
    "seed:apply": "tsx lib/seed/apply-decisions.ts",
    "seed:cycle-factors": "tsx lib/services/cycle-adjustment-service.ts",
    "backfill:content": "tsx lib/cron/backfill-content.ts",
    "backfill:opinions": "tsx lib/cron/backfill-opinions.ts",
    "backfill:gaps": "tsx lib/cron/backfill-gaps.ts",
    "validate:ingest": "tsx lib/cron/validate-ingest.ts",
    "validate:data": "tsx lib/cron/validate-data.ts",
    "cl:purge-noise": "tsx lib/cron/purge-cl-noise.ts",
    "legiscan:bulk": "tsx lib/cron/legiscan-bulk.ts",
    "embeddings:backfill": "tsx lib/cron/embed-missing.ts",
    "layers:enrich": "tsx lib/cron/enrich-layer-scores.ts",
    "layer2:backfill": "tsx lib/cron/backfill-layer2.ts",
    "validate:detection": "tsx lib/cron/validate-detection.ts",
    "l1:distributions": "tsx lib/cron/l1-distributions.ts",
    "validate:narratives": "tsx scripts/validate-narratives.ts",
    "narratives:retry": "tsx lib/cron/retry-narratives.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.73.0",
    "adm-zip": "^0.5.16",
    "cheerio": "^1.1.2",
    "domhandler": "5",
    "drizzle-orm": "^0.45.1",
    "ioredis": "^5.9.2",
    "next": "14.2.5",
    "openai": "^6.18.0",
    "pdf-parse": "1.1.1",
    "pg": "^8.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "xml2js": "0.6.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "20.14.12",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.16.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "10.4.19",
    "drizzle-kit": "^0.31.8",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "knip": "^5.83.1",
    "lint-staged": "^16.2.7",
    "postcss": "8.4.39",
    "prettier": "^3.8.1",
    "tailwindcss": "3.4.10",
    "tsx": "^4.21.0",
    "typescript": "5.5.4",
    "vitest": "^4.0.18"
  }
}
