{
  "description": "Example: Gap year backfill 2019-2020",
  "data": {
    "documents": {
      "where": "published_at >= '2019-01-01' AND published_at < '2021-01-01'"
    },
    "document_scores": {
      "where": "week_of >= '2019-01-01' AND week_of < '2021-01-01'"
    },
    "ai_document_assessments": {
      "where": "week_of >= '2019-01-01' AND week_of < '2021-01-01'"
    },
    "weekly_aggregates": {
      "where": "week_of >= '2019-01-01' AND week_of < '2021-01-01'"
    },
    "narratives": {
      "where": "week_of >= '2019-01-01' AND week_of < '2021-01-01'"
    }
  },
  "updates": {}
}
