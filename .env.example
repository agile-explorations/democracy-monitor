# Public site URL (used for canonical URLs and sitemap generation)
NEXT_PUBLIC_SITE_URL=https://democracymonitor.us

# Comma-separated allowlist for proxy hosts (optional; falls back to lib/allowedHosts.ts)
ALLOWED_PROXY_HOSTS=www.gao.gov,www.defense.gov,oig.ssa.gov,freedomhouse.org,www.oversight.gov,www.reginfo.gov,www.supremecourt.gov,www.federalregister.gov
# Cache TTL in seconds for proxy responses
PROXY_CACHE_TTL=600

# PostgreSQL connection string (required for persistence features)
DATABASE_URL=postgresql://user:password@localhost:5432/epd

# Redis connection string (optional; falls back to in-memory cache)
REDIS_URL=redis://localhost:6379

# AI provider API keys (optional; enables AI-enhanced assessment)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GovInfo API key (optional; enables legislative tracking)
# Get a free key at https://api.govinfo.gov/docs/
GOVINFO_API_KEY=

# CourtListener API token (optional; enables court docket ingestion)
# Get a free token at https://www.courtlistener.com/help/api/rest/
COURTLISTENER_API_TOKEN=

# FEC API key (optional; enables election enforcement tracking)
# Get a free key at https://api.data.gov/signup/
FEC_API_KEY=

# LegiScan API key (optional; enables legislative bill tracking)
# Get a free key at https://legiscan.com/legiscan
LEGISCAN_API_KEY=

# Resend API key (optional; enables email newsletter)
# Get a free key at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Democracy Monitor <updates@democracymonitor.us>
# Operator inbox for cron error alerts (full error details; not the subscriber list)
OPS_ALERT_EMAIL=

# Cron secret (shared between web service and dump cron job)
CRON_SECRET=

# Admin password (optional; enables admin feedback responses at /admin/login)
ADMIN_PASSWORD=

# Maintenance mode (optional; shows "site is being updated" page for all routes)
# Set to "true" during full database pushes. Use NEXT_PUBLIC_ prefix so it's available client-side.
NEXT_PUBLIC_MAINTENANCE_MODE=

# Production database URL (used by db:promote and db:push-prod scripts only)
PROD_DATABASE_URL=

# Search front door (#792): machine bearer for harnesses; pass-cookie HMAC secret (falls back to CRON_SECRET)
SEARCH_MACHINE_TOKEN=
SEARCH_PASS_SECRET=
